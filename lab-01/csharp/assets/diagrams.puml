@startuml d21-decision
!include style.iuml
start
:What is hard about creating this object?;
if (Must exist once?) then (yes)
  #FFF4E6:Singleton (or DI single lifetime);
  stop
elseif (Expensive, reusable?) then (yes)
  #FFF4E6:Object Pool;
  stop
elseif (Many settings, validate together?) then (yes)
  #FFF4E6:Builder;
  stop
elseif (Start from an existing object?) then (yes)
  #FFF4E6:Prototype;
  stop
elseif (Type varies?) then (yes)
  if (A matching family?) then (yes)
    #FFF4E6:Abstract Factory;
  else (one product in a fixed workflow)
    #FFF4E6:Factory Method;
  endif
  stop
else (nothing hard)
  #D3F9D8:Plain new / constructor;
  stop
endif
@enduml
