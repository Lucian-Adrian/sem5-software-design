@startuml d11-prototype-class
!include style.iuml
class GroupPrototype {
  -_template : Group
  +GroupPrototype(Group source)
  +CloneAsDraft(string name) : Group
}
class Group {
  ~Copy(id, name, memberIds) : Group
  +ToInput() : GroupInput
}
GroupPrototype o--> Group : snapshot
GroupPrototype ..> Group : clones
@enduml

@startuml d12-prototype-seq
!include style.iuml
participant Program as C
participant GroupService as S
participant GroupPrototype as P
participant Group as G
C -> S : Get("group-2")
S --> C : source (1 member)
C -> P : new GroupPrototype(source)
P -> G : source.Copy(id, name, members)
G --> P : snapshot with its own list
C -> P : CloneAsDraft("Budget shared home copy")
P -> G : snapshot.Copy("", name, [])
G --> P : draft (no id, 0 members)
P --> C : draft
C -> S : CreateGroup(draft.ToInput())
S --> C : GroupView { id = "group-4", memberCount = 0 }
@enduml

@startuml d13-singleton-class
!include style.iuml
class CatalogDefaults <<sealed>> {
  -{static} _instance : Lazy<CatalogDefaults>
  +{static} Instance : CatalogDefaults
  -CatalogDefaults()
  +DefaultCapacity : int = 3
  +DefaultMaxMonthlyCost : int = 500
}
CatalogDefaults --> CatalogDefaults : _instance
note right of CatalogDefaults
  private constructor: nobody else can call new
  static field: one slot for the whole program
  Lazy<T>: created once, thread-safe
end note
@enduml

@startuml d14-singleton-race
!include style.iuml
participant "Thread 1" as T1
participant "Config class" as C
participant "Thread 2" as T2
T1 -> C : _instance == null? → yes
T2 -> C : _instance == null? → yes
T1 -> C : _instance = new Config() (A)
T2 -> C : _instance = new Config() (B)
note over C #FFE3E3
  Two instances were created.
  Thread 1 may hold A while everyone else uses B.
end note
@enduml

@startuml d15-fm-class
!include style.iuml
abstract class GroupCreator {
  +CreateAndJoin(groups, profiles, founder) : GroupView
  #{abstract} CreateGroupDraft() : GroupInput
}
class StudentGroupCreator {
  #CreateGroupDraft() : GroupInput
}
class QuietGroupCreator {
  #CreateGroupDraft() : GroupInput
}
class CatalogDefaults <<sealed>>
GroupCreator <|-- StudentGroupCreator
GroupCreator <|-- QuietGroupCreator
StudentGroupCreator ..> CatalogDefaults : reads
QuietGroupCreator ..> CatalogDefaults : reads
@enduml

@startuml d16-fm-seq
!include style.iuml
participant Program as C
participant StudentGroupCreator as SC
participant GroupService as GS
participant ProfileService as PS
C -> SC : CreateAndJoin(groups, profiles, founder)
activate SC
note right of SC : base class workflow
SC -> SC : CreateGroupDraft()  // overridden
SC -> GS : CreateGroup(draft)
GS --> SC : group
SC -> PS : CreateProfile(founder)
PS --> SC : profile
SC -> GS : JoinGroup(group.Id, profile.Id)
GS --> SC : joined group
SC --> C : "Student flat: 1/5 members"
deactivate SC
@enduml

@startuml d17-pool-state
!include style.iuml
hide empty description
[*] --> InUse : Acquire(), pool empty\ncreates new
Idle --> InUse : Acquire()
InUse --> Idle : Release() → Clear()\nif idle < maxIdle
InUse --> Dropped : Release()\nwhen pool is full
Dropped --> [*] : garbage collected
@enduml

@startuml d18-pool-seq
!include style.iuml
participant Program as C
participant SummaryBuilderPool as P
C -> P : Summarize(Student flat)
activate P
P -> P : Acquire() → empty → new StringBuilder (Created = 1)
P -> P : build text
P -> P : Release() → Clear(), push
P --> C : "Student flat: 1/5 members, 300 per month"
deactivate P
C -> P : Summarize(Quiet home)
activate P
P -> P : Acquire() → pop the same builder (Created still 1)
P -> P : build text
P -> P : Release() → Clear(), push
P --> C : "Quiet home: 1/2 members, 500 per month"
deactivate P
@enduml

@startuml d19-pool-class
!include style.iuml
class SummaryBuilderPool {
  -_idle : Stack<StringBuilder>
  -maxIdle : int
  +Created : int
  +Acquire() : StringBuilder
  +Release(StringBuilder)
  +Summarize(GroupView) : string
}
class StringBuilder
SummaryBuilderPool o-- "0..maxIdle" StringBuilder : idle
@enduml

