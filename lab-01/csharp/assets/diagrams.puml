@startuml d03-domain
!include style.iuml
class GroupInput <<record>> {
  +Name : string
  +MaxMonthlyCost : int
  +Capacity : int
}
class ProfileInput <<record>> {
  +Name : string
  +MonthlyBudget : int
}
class Group {
  +{static} MaxCapacity = 20
  -_memberProfileIds : List<string>
  +Id : string
  +Name : string
  +MaxMonthlyCost : int
  +Capacity : int
  +{static} Normalize(GroupInput) : GroupInput
  +AddMember(Profile)
  +ToInput() : GroupInput
  +View() : GroupView
  ~Copy(id, name, memberIds) : Group
}
class Profile {
  +Id : string
  +Name : string
  +MonthlyBudget : int
  +View() : ProfileView
}
class GroupService {
  +CreateGroup(GroupInput) : GroupView
  +JoinGroup(groupId, profileId) : GroupView
  +Get(id) : Group
}
class ProfileService {
  +CreateProfile(ProfileInput) : ProfileView
  +Get(id) : Profile
}
GroupService --> ProfileService
GroupService "1" o-- "*" Group
ProfileService "1" o-- "*" Profile
Group ..> GroupInput : validated from
Profile ..> ProfileInput : validated from
Group ..> Profile : AddMember checks budget
@enduml

@startuml d04-join
!include style.iuml
start
:AddMember(profile);
if (Already a member?) then (yes)
  :Return, nothing changes;
  stop
endif
if (Budget >= cost?) then (no)
  #FFE3E3:Throw: budget too low;
  stop
endif
if (Members < capacity?) then (no)
  #FFE3E3:Throw: group is full;
  stop
endif
#D3F9D8:Add profile ID;
stop
@enduml

@startuml d05-builder-class
!include style.iuml
class GroupBuilder {
  -_name : string
  -_maxMonthlyCost : int
  -_capacity : int
  +WithName(string) : GroupBuilder
  +WithMaxMonthlyCost(int) : GroupBuilder
  +WithCapacity(int) : GroupBuilder
  +Build() : GroupInput
}
class GroupInput <<record>>
class Group {
  +{static} Normalize(GroupInput) : GroupInput
}
GroupBuilder ..> GroupInput : creates
GroupBuilder ..> Group : validates through
@enduml

@startuml d06-builder-seq
!include style.iuml
participant Program as C
participant GroupBuilder as B
participant "Group.Normalize" as G
participant GroupService as S
C -> B : new GroupBuilder()
C -> B : WithName("Builder example home")
B --> C : this
C -> B : WithMaxMonthlyCost(650)
B --> C : this
C -> B : WithCapacity(3)
B --> C : this
C -> B : Build()
activate B
B -> G : Normalize(input)
G --> B : clean input
B --> C : GroupInput
deactivate B
C -> S : CreateGroup(input)
S --> C : GroupView { id = "group-1" }
@enduml

@startuml d07-af-class
!include style.iuml
interface IOnboardingPresetFactory {
  +CreateGroupDraft() : GroupInput
  +CreateSuggestedProfile() : ProfileInput
}
class BudgetPresetFactory {
  +CreateGroupDraft() : GroupInput
  +CreateSuggestedProfile() : ProfileInput
}
class ComfortPresetFactory {
  +CreateGroupDraft() : GroupInput
  +CreateSuggestedProfile() : ProfileInput
}
class Presets {
  +{static} Build(IOnboardingPresetFactory) : OnboardingPreset
}
class OnboardingPreset <<record>> {
  +Group : GroupInput
  +SuggestedProfile : ProfileInput
}
class GroupBuilder
IOnboardingPresetFactory <|.. BudgetPresetFactory
IOnboardingPresetFactory <|.. ComfortPresetFactory
Presets --> IOnboardingPresetFactory : depends only on
Presets ..> OnboardingPreset : returns
BudgetPresetFactory ..> GroupBuilder : uses
ComfortPresetFactory ..> GroupBuilder : uses
@enduml

