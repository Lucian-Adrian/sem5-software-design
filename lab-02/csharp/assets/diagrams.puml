@startuml d01-overview
!include style.iuml
left to right direction
rectangle "Client\n<size:11>Program.cs</size>" as C
rectangle "Facade\n<size:11>OnboardingFacade</size>" as F
rectangle "Proxy\n<size:11>AdminOnlyGroupWriter</size>" as P
package "Decorators" {
  rectangle "TimedGroupWriter" as T
  rectangle "AuditedGroupWriter" as AU
}
rectangle "ListingImporter" as I
rectangle "Adapter\n<size:11>LegacyCsvListingAdapter</size>" as A
rectangle "TextFieldParser\n<size:11>.NET library (adaptee)</size>" as TFP #FFF4E6
rectangle "GroupBuilder\n<size:11>Lab 1 Builder</size>" as B #FFF4E6
database "GroupService\nProfileService\nInMemoryStore" as GS
C --> F
C --> I
F --> P : IGroupWriter
F --> GS : IProfileWriter
I --> A : IListingSource
I --> P : IGroupWriter
A --> TFP : ReadFields()
A --> B : Build()
P --> T
T --> AU
AU --> GS
@enduml

@startuml d02-domain
!include style.iuml
class Profile {
  +Id : string
  +Name : string
  +MonthlyBudget : int
}
class Group {
  +Id : string
  +Name : string
  +MaxMonthlyCost : int
  +Capacity : int
  +MemberIds : IReadOnlyList<string>
  +Join(Profile)
}
interface IGroupWriter {
  +CreateGroup(GroupInput) : Group
  +JoinGroup(groupId, profileId) : Group
}
interface IProfileWriter {
  +CreateProfile(ProfileInput) : Profile
}
class GroupService
class ProfileService
class InMemoryStore
IGroupWriter <|.. GroupService
IProfileWriter <|.. ProfileService
GroupService --> InMemoryStore
ProfileService --> InMemoryStore
InMemoryStore o-- Group
InMemoryStore o-- Profile
Group ..> Profile : Join checks budget
@enduml

@startuml d03-adapter
!include style.iuml
interface IListingSource <<Target>> {
  +GetListings() : IEnumerable<GroupInput>
}
class TextFieldParser <<Adaptee, .NET library>> {
  +SetDelimiters(string[])
  +ReadFields() : string[]
  +EndOfData : bool
}
class LegacyCsvListingAdapter <<Adapter>> {
  -_parser : TextFieldParser
  +RejectedRows : List<string>
  +GetListings() : IEnumerable<GroupInput>
  +{static} TryTranslate(fields, out input) : bool
}
class ListingImporter <<Client>> {
  +ImportAll() : List<Group>
}
class GroupBuilder <<Lab 1 Builder>> {
  +Build() : GroupInput
}
IListingSource <|.. LegacyCsvListingAdapter
LegacyCsvListingAdapter o--> TextFieldParser : has-a
LegacyCsvListingAdapter ..> GroupBuilder : creates input with
ListingImporter --> IListingSource : depends on
@enduml

@startuml d04-decorator
!include style.iuml
interface IGroupWriter <<Component>> {
  +CreateGroup(GroupInput) : Group
  +JoinGroup(groupId, profileId) : Group
}
class GroupService <<ConcreteComponent>>
abstract class GroupWriterDecorator <<Decorator>> {
  #Inner : IGroupWriter
  +CreateGroup(GroupInput) : Group
  +JoinGroup(groupId, profileId) : Group
}
class AuditedGroupWriter <<ConcreteDecorator>> {
  -log : TextWriter
  -Record(operation, call) : Group
}
class TimedGroupWriter <<ConcreteDecorator>> {
  -log : TextWriter
  -Time(operation, call) : Group
}
IGroupWriter <|.. GroupService
IGroupWriter <|.. GroupWriterDecorator
GroupWriterDecorator <|-- AuditedGroupWriter
GroupWriterDecorator <|-- TimedGroupWriter
GroupWriterDecorator o--> IGroupWriter : Inner
@enduml

@startuml d05-decorator-seq
!include style.iuml
participant Program as C
participant TimedGroupWriter as T
participant AuditedGroupWriter as A
participant GroupService as S
participant Group as G
C -> T : JoinGroup(g, p)
activate T
T -> T : start stopwatch
T -> A : JoinGroup(g, p)
activate A
A -> S : JoinGroup(g, p)
S -> G : Join(profile)
G --> S : ok or DomainException
S --> A : group or exception
A -> A : write "[audit] ..."
A --> T : same group or rethrow
deactivate A
T -> T : finally: write "[timer] ..."
T --> C : same group or exception
deactivate T
@enduml

@startuml d06-facade
!include style.iuml
class OnboardingFacade <<Facade>> {
  +Onboard(ProfileInput, GroupInput) : OnboardingResult
}
interface IProfileWriter <<Subsystem>> {
  +CreateProfile(ProfileInput) : Profile
}
interface IGroupWriter <<Subsystem>> {
  +CreateGroup(GroupInput) : Group
  +JoinGroup(groupId, profileId) : Group
}
class OnboardingResult <<record>> {
  +Profile : Profile
  +Group : Group
}
OnboardingFacade o--> IProfileWriter
OnboardingFacade o--> IGroupWriter
OnboardingFacade ..> OnboardingResult : returns
IProfileWriter <|.. ProfileService
IGroupWriter <|.. AdminOnlyGroupWriter
@enduml

@startuml d07-facade-seq
!include style.iuml
participant Client as F
participant OnboardingFacade as O
participant IProfileWriter as P
participant IGroupWriter as G
F -> O : Onboard(person, group)
activate O
O -> O : build draft Profile and Group\ncheck budget >= cost
alt invalid
  O --> F : DomainException (nothing written)
else valid
  O -> P : CreateProfile(person)
  P --> O : profile
  O -> G : CreateGroup(group)
  G --> O : group
  O -> G : JoinGroup(group.Id, profile.Id)
  O --> F : OnboardingResult
end
deactivate O
@enduml

@startuml d08-proxy
!include style.iuml
interface IGroupWriter <<Subject>> {
  +CreateGroup(GroupInput) : Group
  +JoinGroup(groupId, profileId) : Group
}
interface ICurrentUser {
  +Name : string
  +IsAdmin : bool
}
class AdminOnlyGroupWriter <<Proxy>> {
  -real : IGroupWriter
  -user : ICurrentUser
  +CreateGroup() : checks IsAdmin first
  +JoinGroup() : passes through
}
class TimedGroupWriter <<RealSubject here>>
IGroupWriter <|.. AdminOnlyGroupWriter
IGroupWriter <|.. TimedGroupWriter
AdminOnlyGroupWriter o--> IGroupWriter : real
AdminOnlyGroupWriter --> ICurrentUser
ICurrentUser <|.. SessionUser
@enduml
